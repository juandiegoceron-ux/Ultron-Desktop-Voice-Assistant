# ============================================================================
# ULTRÓN - CONFIGURACIÓN DE ENTORNO (Juan Diego Cerón Duque)
# ============================================================================

# Nombre del asistente y usuario principal
ULTRON_NAME=Ultrón
ULTRON_USER_NAME=Juan Diego
ULTRON_DEFAULT_LANG=es

# Motor STT: "whisper" (100% offline con faster-whisper) o "google" (híbrido/online)
ULTRON_STT_ENGINE=whisper
ULTRON_WHISPER_MODEL=base

# Wake-Word (Palabra de activación)
ULTRON_WAKE_WORD_ENABLED=true
ULTRON_WAKE_WORDS=ultron,ultrón,hey ultron,oye ultron

# Integración con IA Generativa (LLM)
# Proveedor: "gemini" (Google Gemini API) o "ollama" (Local LLM)
ULTRON_LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Configuración opcional para Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
